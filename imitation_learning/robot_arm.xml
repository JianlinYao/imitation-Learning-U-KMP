<mujoco model="educational_planar_2r">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.05" armature="0.01" limited="true"/>
    <geom friction="0.7 0.01 0.001" rgba="0.14 0.39 0.55 1"/>
    <motor ctrllimited="true" ctrlrange="-5 5"/>
  </default>
  <worldbody>
    <light pos="0 0 2"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.92 0.94 0.96 1"/>
    <geom name="pedestal" type="cylinder" pos="0 0 0.12" size="0.05 0.12"/>
    <body name="upper_arm" pos="0 0 0.30">
      <joint name="shoulder" range="-2.7 2.7"/>
      <geom name="upper_link" type="capsule" fromto="0 0 0 0.32 0 0" size="0.016" mass="0.6"/>
      <site name="base" size="0.008"/>
      <body name="forearm" pos="0.32 0 0">
        <joint name="elbow" range="0.1 3.0"/>
        <geom name="lower_link" type="capsule" fromto="0 0 0 0.28 0 0" size="0.014" mass="0.4"/>
        <site name="elbow_site" size="0.008"/>
        <site name="tip" pos="0.28 0 0" size="0.012" rgba="0.94 0.40 0.22 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder"/>
    <motor name="elbow_motor" joint="elbow"/>
  </actuator>
</mujoco>
